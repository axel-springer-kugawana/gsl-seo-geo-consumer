{
  "asyncapi": "2.6.0",
  "info": {
    "title": "<%= it.SSoTName %> SSoT Stream API",
    "version": "1.0.0"
  },
  "channels": {
    "<%= it.SSoTEntityName %>Events": {
      "publish": {
        "message": {
          "oneOf": [
            {
              "$ref": "#/components/messages/<%= it.SSoTEntityName %>UpdatedEvent"
            },
            {
              "$ref": "#/components/messages/<%= it.SSoTEntityName %>CreatedEvent"
            },
            {
              "$ref": "#/components/messages/<%= it.SSoTEntityName %>DeletedEvent"
            }
          ]
        }
      }
    }
  },
  "components": {
    "messages": {
      "<%= it.SSoTEntityName %>UpdatedEvent": {
        "payload": {
          "title": "<%= it.SSoTEntityName %>UpdatedEvent",
          "allOf": [
            {
              "$ref": "#/components/schemas/CloudEvent"
            },
            {
              "type": "object",
              "title": "<%= it.SSoTEntityName %>UpdatedData",
              "properties": {
                "type": {
                  "title": "<%= it.SSoTEntityName %>UpdatedEventType",
                  "const": "<%= it.SSoTEntityName.toLowerCase() %>-updated.v1"
                },
                "data": {
                  "title": "<%= it.SSoTEntityName %>StateEventData",
                  "$ref": "#/components/schemas/<%= it.SSoTEntityName %>StateEventData"
                }
              }
            }
          ]
        }
      },
      "<%= it.SSoTEntityName %>DeletedEvent": {
        "payload": {
          "title": "<%= it.SSoTEntityName %>DeletedEvent",
          "allOf": [
            {
              "$ref": "#/components/schemas/CloudEvent"
            },
            {
              "type": "object",
              "title": "<%= it.SSoTEntityName %>DeletedData",
              "properties": {
                "type": {
                  "title": "<%= it.SSoTEntityName %>DeletedEventType",
                  "const": "<%= it.SSoTEntityName.toLowerCase() %>-deleted.v1"
                },
                "data": {
                  "title": "<%= it.SSoTEntityName %>DeletedEventData",
                  "$ref": "#/components/schemas/<%= it.SSoTEntityName %>DeletedEventData"
                }
              }
            }
          ]
        }
      },
      "<%= it.SSoTEntityName %>CreatedEvent": {
        "payload": {
          "title": "<%= it.SSoTEntityName %>CreatedEvent",
          "allOf": [
            {
              "$ref": "#/components/schemas/CloudEvent"
            },
            {
              "type": "object",
              "title": "<%= it.SSoTEntityName %>CreatedData",
              "properties": {
                "type": {
                  "title": "<%= it.SSoTEntityName %>CreatedEventType",
                  "const": "<%= it.SSoTEntityName.toLowerCase() %>-created.v1"
                },
                "data": {
                  "title": "<%= it.SSoTEntityName %>StateEventData",
                  "$ref": "#/components/schemas/<%= it.SSoTEntityName %>StateEventData"
                }
              }
            }
          ]
        }
      }
    },
    "schemas": {
      "CloudEvent": {
        "title": "CloudEventEnvelope",
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "source": {
            "type": "string"
          },
          "idempotencykey": {
            "type": "string",
            "format": "uuid"
          },
          "data": {
            "type": "object"
          },
          "type": {
            "type": "string"
          },
          "specversion": {
            "type": "string",
            "const": "1.0"
          }
        },
        "required": [
          "data",
          "id",
          "type",
          "source",
          "specversion"
        ]
      },
      "<%= it.SSoTEntityName %>StateEventData": 
         <%= it.SSoTEntityModel %> 
      ,
      "<%= it.SSoTEntityName %>DeletedEventData": {
        "allOf": [
          {
            "title": "<%= it.SSoTEntityName %>Data",
          
          
            "$schema": "http://json-schema.org/draft-07/schema#",
            "type": "object",
            
            "properties": {
              "id": {
                "type": "string"
              }
            },
            "required": [
              "id"
            ]
          },
          {
            "$schema": "http://json-schema.org/draft-07/schema#",
            "type": "object",
            "title": "<%= it.SSoTEntityName %>Metadata",
            "properties": {
              "metadata": {
                "$id": "SsotEntityMetadata",
                "type": "object",
                "properties": {
                  "objectVersion": {
                    "type": "number"
                  },
                  "dataModelVersion": {
                    "type": "string"
                  },
                  "partition": {
                    "type": "string"
                  }
                },
                "required": [
                  "objectVersion",
                  "dataModelVersion",
                  "partition"
                ]
              }
            },
            "required": [
              "metadata"
            ]
          }
        ]
      }
    }
  }
}
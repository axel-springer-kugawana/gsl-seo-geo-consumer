{
  "asyncapi": "2.6.0",
  "info": {
    "title": "<%= it.SSoTName %> SSOT Stream API",
    "version": "1.0.0"
  },
  "channels": {
    "ssot-events": {
      "subscribe": {
        "message": {
          "oneOf": [
            {
              "$ref": "#/components/messages/<%= it.SSoTEntityName %>Created"
            },
            {
              "$ref": "#/components/messages/<%= it.SSoTEntityName %>Updated"
            },
            {
              "$ref": "#/components/messages/<%= it.SSoTEntityName %>Deleted"
            }
          ]
        }
      }
    }
  },
  "components": {
    "messages": {
      "<%= it.SSoTEntityName %>Updated": {
        "payload": {
          "$ref": "#/components/schemas/<%= it.SSoTEntityName %>UpdatedEvent"
        }
      },
      "<%= it.SSoTEntityName %>Deleted": {
        "payload": {
          "$ref": "#/components/schemas/<%= it.SSoTEntityName %>DeletedEvent"
        }
      },
      "<%= it.SSoTEntityName %>Created": {
        "payload": {
          "$ref": "#/components/schemas/<%= it.SSoTEntityName %>CreatedEvent"
        }
      }
    },
    "schemas": {
      "<%= it.SSoTEntityName %>DeletedEvent": {
        "type": "object",
        "additionalProperties": false,
        "allOf": [
          {
            "$ref": "#/components/schemas/EventEnvelope"
          }
        ],
        "properties": {
          "data": {
            "$ref": "#/components/schemas/<%= it.SSoTEntityName %>DeletedEventData"
          },
          "type": {
            "$ref": "#/components/schemas/<%= it.SSoTEntityName %>DeletedV1EventType"
          }
        },
        "required": [
          "data",
          "type"
        ]
      },
      "<%= it.SSoTEntityName %>CreatedEvent": {
        "type": "object",
        "additionalProperties": false,
        "allOf": [
          {
            "$ref": "#/components/schemas/EventEnvelope"
          }
        ],
        "properties": {
          "data": {
            "$ref": "#/components/schemas/<%= it.SSoTEntityName %>StateEventData"
          },
          "type": {
            "$ref": "#/components/schemas/<%= it.SSoTEntityName %>CreatedV1EventType"
          },
          "subject": {
            "type": "string"
          }
        },
        "required": [
          "data",
          "type"
        ]
      },
      "<%= it.SSoTEntityName %>UpdatedEvent": {
        "type": "object",
        "additionalProperties": false,
        "allOf": [
          {
            "$ref": "#/components/schemas/EventEnvelope"
          }
        ],
        "properties": {
          "data": {
            "$ref": "#/components/schemas/<%= it.SSoTEntityName %>StateEventData"
          },
          "type": {
            "$ref": "#/components/schemas/<%= it.SSoTEntityName %>UpdatedV1EventType"
          },
          "subject": {
            "type": "string"
          }
        },
        "required": [
          "data",
          "type"
        ]
      },
      "EventEnvelope": {
        "type": "object",
        "allOf": [
          {
            "$ref": "https://raw.githubusercontent.com/cloudevents/spec/v1.0.1/spec.json"
          }
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "idempotencykey": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "<%= it.SSoTEntityName %>StateEventData": <%= it.SSoTEntityModel %>,
      "<%= it.SSoTEntityName %>CreatedV1EventType": {
        "type": "string",
        "enum": [
          "<%= it.SSoTEntityName %>-created.v1"
        ]
      },
      "<%= it.SSoTEntityName %>UpdatedV1EventType": {
        "type": "string",
        "enum": [
          "<%= it.SSoTEntityName %>-updated.v1"
        ]
      },
      "<%= it.SSoTEntityName %>DeletedV1EventType": {
        "type": "string",
        "enum": [
          "<%= it.SSoTEntityName %>-deleted.v1"
        ]
      },
      "<%= it.SSoTEntityName %>DeletedEventData": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          }
        }
      }
    }
  }
}
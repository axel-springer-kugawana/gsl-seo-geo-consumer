{
	"name": "api-with-lambda-template",
	"scripts": {
		"format": "prettier --config .prettierrc './**/*.ts' --write",
		"lint": "eslint . --ext .ts",
		"build:lambdas": "node esbuild.config.js",
		"watch": "tsc --noEmit --watch",
		"local": "tsx ./local/local-lambda-invoke.ts",
		"test:unit": "jest",
		"gen-dto-schemas": "openapi-zod-client ./apidocs.yml -o ./user-profile-management/dtos/schemas.ts -t ./user-profile-management/dtos/schemas-template.hbs --media-type-expr \"mediaType.startsWith('application/')\""
	},
	"devDependencies": {
		"@smithy/types": "^2.12.0",
		"@types/aws-lambda": "^8.10.136",
		"@types/convict": "^6.1.6",
		"@types/express": "^4.17.21",
		"@types/jest": "^29.5.12",
		"@types/node": "^20.11.30",
		"@types/uuid": "^9.0.8",
		"@typescript-eslint/eslint-plugin": "^7.4.0",
		"aws-sdk-client-mock": "^3.1.0",
		"dotenv": "^16.4.5",
		"esbuild": "^0.17.19",
		"esbuild-plugin-tsc": "^0.4.0",
		"eslint-config-prettier": "^9.1.0",
		"eslint-plugin-prettier": "^5.1.3",
		"express": "^4.19.2",
		"glob": "^10.3.10",
		"jest": "^29.7.0",
		"jest-html-reporters": "^3.1.7",
		"openapi-zod-client": "^1.16.3",
		"prettier": "^3.2.5",
		"ts-jest": "^29.1.2",
		"tsx": "^4.7.1",
		"typescript": "^4.9.5"
	},
	"dependencies": {
		"@aws-lambda-powertools/batch": "^1.18.1",
		"@aws-lambda-powertools/logger": "^1.18.1",
		"@aws-lambda-powertools/metrics": "^1.18.1",
		"@aws-sdk/client-dynamodb": "^3.540.0",
		"@middy/core": "^4.7.0",
		"convict": "^6.2.4",
		"nanoid": "^5.0.6",
		"uuid": "^9.0.1",
		"zod": "^3.22.4"
	}
}
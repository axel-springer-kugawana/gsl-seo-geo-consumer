{
  "compilerOptions": {
    "target": "ES2020",
    "lib": [
      "ESNext"
    ],
    "module": "ESNext",
    "outDir": "./dist",
    "typeRoots": [
      "node_modules/@types"
    ],
    "baseUrl": "./",
    "paths": {},
    "skipLibCheck": true,
    "removeComments": true,
    "inlineSourceMap": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "moduleResolution": "node",
    "esModuleInterop": true,
    "resolveJsonModule": true
  },
  "exclude": [
    "esbuild.config.mjs",
    "node_modules",
    "**/*.spec.ts"
  ],
  "require": [
    "ts-node/register/transpile-only"
  ],
  "ts-node": {
    "require": [
      "tsconfig-paths/register"
    ]
  }
}
{
  "name": "ssot-consumer",
  "scripts": {
    "build:lambdas": "node esbuild.config.js",
    "build:tasks": "node esbuild.tasks.config.js",
    "smoke:geo-bulk-load": "npm run build:tasks && node -e \"const task = require('./dist/geo-bulk-load/main.js'); if (typeof task.processMassiveParquetToPostgres !== 'function') process.exit(2); console.log('geo-bulk-load bundle smoke test passed')\"",
    "watch": "tsc --noEmit --watch",
    "local": "tsx ./local/local-lambda-invoke.ts",
    "local:geo-bulk-load": "tsx ./geo-bulk-load/main.ts",
    "test": "jest",
    "test:debug": "jest --runInBand",
    "generate:models": "openapi-typescript https://place-api.cosmic-bullfrog-preview.aws.aviv.eu/v1/openapi.json -o ./shared/models/geo-api.ts --exclude-deprecated"
  },
  "devDependencies": {
    "@aws-sdk/util-stream-node": "^3.374.0",
    "@types/aws-lambda": "^8.10.114",
    "@types/convict": "^6.1.4",
    "@types/express": "^4.17.18",
    "@types/jest": "^29.5.2",
    "@types/node": "^22.10.2",
    "@types/pg": "8.10.7",
    "@types/uuid": "^9.0.2",
    "aws-sdk-client-mock": "^3.0.0",
    "dotenv": "^16.3.1",
    "esbuild": "^0.17.0",
    "esbuild-plugin-tsc": "^0.4.0",
    "express": "^4.18.2",
    "glob": "^10.2.2",
    "jest": "^29.5.0",
    "openapi-fetch": "0.9.3",
    "openapi-typescript": "6.5.0",
    "ts-jest": "^29.1.0",
    "tsx": "^4.6.2",
    "typescript": "^4.9.4",
    "vite-tsconfig-paths": "^4.3.2",
    "vitest": "^1.6.0"
  },
  "dependencies": {
    "@aws-lambda-powertools/parameters": "^2.34.0",

    "@aws-lambda-powertools/batch": "^1.14.2",
    "@aws-lambda-powertools/logger": "^1.14.0",
    "@aws-lambda-powertools/metrics": "^1.14.0",
    "@aws-sdk/client-dynamodb": "^3.454.0",
    "@aws-sdk/client-s3": "^3.428.0",
    "@aws-sdk/client-secrets-manager": "^3.1117.0",
    "@aws-sdk/client-sns": "^3.382.0",
    "@aws-sdk/client-sqs": "^3.379.1",
    "@aws-sdk/credential-provider-sso": "^3.848.0",
    "@aws-sdk/util-dynamodb": "^3.454.0",
    "@duckdb/node-api": "1.5.5-r.4",
    "@middy/core": "^4.6.0",
    "axios": "^1.7.7",
    "convict": "^6.2.4",
    "pg": "8.11.3",
    "postgresql-client": "^2.10.6",
    "uuid": "^9.0.1",
    "zod": "3.22.4"
  }
}

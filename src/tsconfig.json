{
    "compilerOptions": {
        "target": "ES2020",
        "lib": [
            "ESNext"
        ],
        "module": "ESNext",
        "outDir": "./dist",
        "typeRoots": [
            "node_modules/@types"
        ],
        "baseUrl": "./",
        "paths": {
            "@shared/*": [
                "shared/*"
            ],
            "@cm-connector/*": [
                "cm-connector/*"
            ],
            "@geo-bulk-load/*": [
                "geo-bulk-load/*"
            ],
            "@models": ["models/index"],
            "@utils": ["utils/index"]
        },
        "skipLibCheck": true,
        "removeComments": true,
        "inlineSourceMap": true,
        "experimentalDecorators": true,
        "emitDecoratorMetadata": true,
        "moduleResolution": "node",
        "esModuleInterop": true,
        "resolveJsonModule": true
    },  
      "include": ["**/*.ts"],
    "exclude": [
        "esbuild.config.js",
        "node_modules",
        "**/*.spec.ts"
    ],
    "require": [
        "ts-node/register/transpile-only"
    ],
    "ts-node": {
        "require": [
            "tsconfig-paths/register"
        ]
    }
}